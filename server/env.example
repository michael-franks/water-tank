DB_PATH=server/data/readings.db
DEFAULT_DEVICE_ID=tank-1
ALERT_HYSTERESIS_PCT=2.0
INGEST_API_KEY=change-me

# Tank capacity in liters (used for feed-in L/h and days-remaining; default 30000)
# TANK_CAPACITY_LITERS=30000

# Alerting via Web Push (VAPID). Push is the ONLY alert channel — email/SMS
# were removed. If these are unset, notify() is a no-op and no alerts are sent.
# Generate a keypair (base64url) with any VAPID tool, e.g. py_vapid, and keep the
# private key secret. The public key is handed to the browser (safe to expose).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# VRBO / Bookabach iCal feed for booking-aware dashboard.
# Get from VRBO owner dashboard: Properties → listing → Calendar → Import/Export →
# Export this calendar. Leave blank to disable booking sync (table stays empty).
# Treat as low-grade secret; URL grants read access to all booking dates.
# Supports http(s):// (real feed) and file:// (local testing).
BOOKINGS_ICAL_URL=
# How often to re-fetch the feed (minutes). 60 is fine for a personal bach.
BOOKINGS_SYNC_INTERVAL_MINUTES=60
